{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://envira.example/schema/artifact-manifest-v1.json",
  "title": "ENVIRA artifact manifest v1",
  "type": "object",
  "required": ["schema_version", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "run_status": {"enum": ["complete", "complete_with_warnings", "partial", "failed"]},
    "source_pdf_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "sensitivity": {"enum": ["public_metadata", "operational_metadata", "derived_sensitive", "raw_sensitive", "secret_redacted"]}
        }
      }
    }
  }
}
