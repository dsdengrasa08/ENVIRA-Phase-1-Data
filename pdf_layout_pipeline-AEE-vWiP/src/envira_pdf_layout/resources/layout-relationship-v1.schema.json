{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://envira.example/schema/layout-relationship-v1.json",
  "title": "ENVIRA layout relationship v1",
  "type": "object",
  "required": ["relationship_schema_version", "kind", "geometry_version"],
  "properties": {
    "relationship_schema_version": {"const": 1},
    "kind": {"type": "string", "minLength": 1},
    "geometry_version": {"type": "integer", "minimum": 1}
  }
}
