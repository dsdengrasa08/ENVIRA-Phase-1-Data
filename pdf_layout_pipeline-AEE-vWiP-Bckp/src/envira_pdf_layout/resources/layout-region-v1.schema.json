{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://envira.example/schema/layout-region-v1.json",
  "title": "ENVIRA layout region v1",
  "type": "object",
  "required": ["region_schema_version", "layout_region_id", "page_number", "type", "bbox_px", "source_bbox_px", "resolved_bbox_px", "geometry_version", "geometry_history", "coordinate_space"],
  "properties": {
    "region_schema_version": {"const": 1},
    "layout_region_id": {"type": "string", "minLength": 1},
    "page_number": {"type": "integer", "minimum": 1},
    "type": {"type": "string", "minLength": 1},
    "bbox_px": {"$ref": "#/$defs/bbox"},
    "source_bbox_px": {"$ref": "#/$defs/bbox"},
    "proposed_bbox_px": {"$ref": "#/$defs/bbox"},
    "resolved_bbox_px": {"$ref": "#/$defs/bbox"},
    "physical_bbox_px": {"$ref": "#/$defs/bbox"},
    "visual_crop_bbox_px": {"$ref": "#/$defs/bbox"},
    "semantic_group_bbox_px": {"$ref": "#/$defs/bbox"},
    "geometry_version": {"type": "integer", "minimum": 1},
    "geometry_history": {"type": "array", "items": {"type": "object"}},
    "coordinate_space": {"type": "object", "required": ["units", "origin", "page_number"]}
  },
  "$defs": {"bbox": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 4, "maxItems": 4}}
}
